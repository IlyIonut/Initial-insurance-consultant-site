# Cheia reală se setează local în .env.local și în Vercel Environment Variables.
# Nu publica niciodată cheia OpenAI în GitHub.
OPENAI_API_KEY=your_openai_api_key_here

# Opțional. Dacă lipsește, API-ul folosește modelul implicit din cod.
OPENAI_MODEL=gpt-5.4-mini

# Opțional. Dacă setezi un endpoint de formulare, ContactForm va trimite JSON acolo.
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://exemplu.ro/api/contact
